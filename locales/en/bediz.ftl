settings-title = Bediz settings
settings-search-placeholder = Find a setting
settings-search-empty = No setting matches “{ $query }”.
settings-on = On
settings-off = Off
settings-section-general = General
settings-start-with-windows = Start with Windows
    .keywords = startup, sign in, launch, autostart, boot
settings-start-with-windows-detail = Bediz waits in the tray, so the shortcut works as soon as you sign in. If you turn it off in Task Manager, Bediz leaves that alone.
settings-start-turned-off = Windows does not start Bediz, since it is turned off in Task Manager. Turn it on there under Startup apps.
settings-start-problem = Bediz could not change whether Windows starts it, so this may not happen as set: { $reason }
settings-language = Language
    .keywords = language, translation, English
settings-language-detail = The window and the tray menu switch at once.
settings-language-system = Same as Windows
settings-theme = Look
    .keywords = theme, dark, light, mode, appearance
settings-theme-detail = Light or dark; when it follows Windows, it changes with Windows.
settings-theme-system = Same as Windows
settings-theme-light = Light
settings-theme-dark = Dark
settings-accent = Accent colour
    .keywords = colour, color, accent, blue, teal, purple, pink
settings-accent-detail = Used for switches, chosen items and buttons.
settings-accent-blue = Blue
settings-accent-teal = Teal
settings-accent-purple = Purple
settings-accent-pink = Pink
settings-section-shortcuts = Shortcuts
settings-hotkey-registered = { $key } opens Bediz
settings-hotkey-registered-detail = Press it to select a region.
settings-hotkey-snipping-tool = Print Screen opens the Snipping Tool
settings-hotkey-snipping-tool-detail = Windows gives this key to the Snipping Tool. Bediz can turn that Windows setting off for you.
settings-hotkey-take = Let Bediz use Print Screen
settings-hotkey-taken = Another app uses { $key }
settings-hotkey-taken-detail = An app such as Lightshot, OneDrive or Dropbox holds the key. Turn it off there, then choose Try again, or choose another shortcut below.
settings-hotkey-retry = Try again
settings-hotkey-region = Select a region
    .keywords = shortcut, hotkey, key, Print Screen, PrtSc
settings-hotkey-region-detail = The screen freezes; select a part of it to copy or save it.
settings-hotkey-change = Change
settings-hotkey-cancel = Cancel
settings-hotkey-listening = Press the keys… Esc cancels.
settings-hotkey-needs-modifier = { $key } alone would stop that key from typing in every app. Hold Ctrl or Alt with it.
settings-hotkey-unsupported = That key cannot be a shortcut. Use a letter, a digit, a function key, Print Screen, Pause, Scroll Lock or a navigation key.
settings-ask-about-hotkey = Ask at start when another app has the shortcut
    .keywords = Snipping Tool, Lightshot, question, Print Screen
settings-ask-about-hotkey-detail = If the Snipping Tool or another app holds the key, Bediz asks once as it starts.
settings-elevated-note = Windows does not pass Print Screen alone to Bediz while a window running as administrator is in front. A shortcut with Ctrl, Alt or Shift, such as Ctrl+Shift+F9, still arrives, and so does a click on the tray icon.
settings-section-selecting = Selecting
settings-detect-windows = Highlight the window under the pointer
    .keywords = window detection, click, select a window
settings-detect-windows-detail = A click selects that window. When off, a click selects nothing; drag to select.
settings-success-labels = Show “Copied” and “Saved”
    .keywords = notice, label, message, confirmation, toast
settings-success-labels-detail = A short notice where the selection was. Errors are always shown.
settings-enter = Enter and double-click
    .keywords = enter, double click, copy, save
settings-enter-detail = Ctrl+C always only copies, Ctrl+S only saves.
settings-enter-copy-and-save = Copy and save
settings-enter-copy = Copy only
settings-enter-save = Save only
settings-section-saving = Saving and clipboard
settings-folder = Folder
    .keywords = location, save folder, Pictures, Screenshots, OneDrive
settings-folder-open = Open folder
settings-folder-change = Change…
settings-folder-reset = Use Screenshots
settings-folder-onedrive = OneDrive syncs this folder: every saved screenshot is uploaded to OneDrive too. Choose a folder it does not sync if you do not want that.
settings-folder-failed = The folder cannot be used: { $reason }
settings-reason-missing = { $path } does not exist or is not a folder.
settings-reason-unexpected = something unexpected happened; the log has the details.
settings-file-name = File name
    .keywords = name, pattern, date, time, width, height
settings-file-name-detail = If the name is taken, (2), (3) and on are added; no file is ever replaced.
settings-file-name-insert = Insert:
settings-file-name-date = date
settings-file-name-time = time
settings-file-name-width = width
settings-file-name-height = height
settings-file-name-example = Example: { $name }
settings-file-name-empty = The file name cannot be empty.
settings-file-name-forbidden = A file name cannot hold \ / : * ? " < > |
settings-file-name-unknown = { $token } is not known; insert the date, time, width or height with the buttons.
settings-file-name-long = The file name can be at most { $limit } characters long.
settings-file-name-reserved = Windows keeps the name { $name } for devices; choose another one.
settings-keep-out-of-history = Keep screenshots out of Win+V history
    .keywords = clipboard, history, Win+V, cloud
settings-keep-out-of-history-detail = Pasting still works; they only stay out of the history. They never reach the cloud clipboard either way.
settings-section-memory = Memory
settings-release-gpu = Release graphics memory while idle
    .keywords = GPU, VRAM, video memory, graphics card, performance, speed
settings-release-gpu-detail = Uses less graphics memory between screenshots; the selection opens a few milliseconds later.
settings-section-updates = Updates
