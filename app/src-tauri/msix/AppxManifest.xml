<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">
  <!-- pack.ps1 sets the version from Cargo.toml and, for the Store, the identity from Partner Center. -->
  <Identity Name="Bediz" Publisher="CN=halledilirya" Version="0.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Bediz</DisplayName>
    <PublisherDisplayName>halledilirya</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ar" />
    <Resource Language="de" />
    <Resource Language="es" />
    <Resource Language="fr" />
    <Resource Language="hi" />
    <Resource Language="it" />
    <Resource Language="ja" />
    <Resource Language="ko" />
    <Resource Language="pt-br" />
    <Resource Language="ru" />
    <Resource Language="tr" />
    <Resource Language="zh-hans" />
  </Resources>
  <Applications>
    <Application Id="Bediz" Executable="bediz.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Bediz"
        Description="A screenshot app that waits in the tray"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap5:Extension
          Category="windows.startupTask"
          Executable="bediz.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="Bediz" Enabled="false" DisplayName="Bediz" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
